func test_target_record_parse() {
    let rec = "TARGET|web|example.com|80"
    let f = split(rec, "|")
    assert_eq(f[0], "TARGET")
    assert_eq(f[1], "web")
    assert_eq(f[2], "example.com")
    assert_eq(int(f[3]), 80)
}

func test_sample_dedupe() {
    let state = ["SAMPLE|web|1|12"]
    let rec = "SAMPLE|web|1|12"
    let seen = 0
    let i = 0
    while (i < len(state)) {
        if (state[i] == rec) { seen = 1 }
        i = i + 1
    }
    assert_eq(seen, 1)
    assert_eq(len(state), 1)
    let newrec = "SAMPLE|web|0|0"
    push(state, newrec)
    assert_eq(len(state), 2)
}

func test_availability_core() {
    let state = ["SAMPLE|web|1|12", "SAMPLE|web|1|15", "SAMPLE|web|1|10", "SAMPLE|web|0|0"]
    let total = 0
    let ok = 0
    let i = 0
    while (i < len(state)) {
        let f = split(state[i], "|")
        if (f[0] == "SAMPLE") {
            if (f[1] == "web") {
                total = total + 1
                if (int(f[2]) == 1) { ok = ok + 1 }
            }
        }
        i = i + 1
    }
    assert_eq(total, 4)
    assert_eq(ok, 3)
    assert_eq((ok * 100) / total, 75)
}
